# =====================================================================
# Issue Solver — environment configuration
# Copy this file to .env (same directory) and fill in your keys.
# =====================================================================

# --- Primary LLM: MiniMax (free) via OpenRouter ----------------------
# Get a key at https://openrouter.ai/keys
# NEVER commit a real key here — put it in .env (gitignored)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Free MiniMax model. Comma-separated candidates are tried in order, so a model
# that disappears from the free tier does not fail the run.
# Verify current free models at https://openrouter.ai/models
PRIMARY_MODEL=minimax/minimax-m3.1-flash:free

# --- Fallback LLM: Google Gemini (free tier) --------------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free-tier Gemini retires model names for newer accounts (404) and sheds traffic
# per model (503), so list a chain. gemini-flash-lite-latest answers today;
# list https://generativelanguage.googleapis.com/v1beta/models to see yours.
GEMINI_MODEL=gemini-flash-lite-latest,gemini-flash-latest

# --- GitHub ------------------------------------------------------------
# Two tokens are supported. The classic one is preferred for every read and
# write because it is the only kind that can fork someone else's repository.
#
# GITHUB_TOKEN: fine-grained PAT.
#   Contents: Read/Write + Pull requests: Read/Write (+ Issues: Read/Write to
#   read private issues). Works for repositories you own or can push to.
GITHUB_TOKEN=
#
# GITHUB_CLASSIC_TOKEN: classic PAT with the `repo` scope.
#   Required to solve an issue in somebody else's repository: the agent forks
#   it into your account, pushes the fix branch there, and opens a cross-repo
#   pull request against the upstream. Create one at
#   https://github.com/settings/tokens/new?scopes=repo
# Without any token, public issues can still be read (low rate limit) and the
# fix is produced and tested locally, but nothing is pushed.
GITHUB_CLASSIC_TOKEN=

# Set to false to never fork a repository; fixes for foreign repos then stop at
# a local commit instead of opening a pull request.
ALLOW_FORK=true

# Take the fork route even for a repository you can push to directly - useful when
# you already own a fork of the project and want the PR to come from it. GitHub
# will not fork a repository into the account that owns it, so for your own repos
# this simply falls back to a direct push.
PREFER_FORK=false

# --- Execution budgets (seconds) ---------------------------------------
OVERALL_TIMEOUT_S=240
CLONE_TIMEOUT_S=90
INSTALL_TIMEOUT_S=60
TEST_TIMEOUT_S=75
LLM_TIMEOUT_S=120
# How long to wait for GitHub to finish creating a fork (forking is async).
FORK_WAIT_TIMEOUT_S=60

# --- Context / token budgets (characters) ------------------------------
MAX_FILE_CHARS=14000
MAX_FILES_READ=3
REPO_MAP_MAX_ENTRIES=300
ISSUE_BODY_MAX_CHARS=3500
